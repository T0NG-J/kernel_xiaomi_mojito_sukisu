# SukiSU-Ultra + SUSFS for Redmi Note 10 (mojito/sunny), NetErnels base.
#
# Merge on top of neternels_defconfig. Not optional if KernelSU is present:
# SukiSU's Kconfig marks CONFIG_KSU and CONFIG_KSU_SUSFS "default y", so
# leaving this out still pulls KSU in - just without a coherent SUSFS setup.

CONFIG_KSU=y
CONFIG_KSU_MANUAL_HOOK=y
# CONFIG_KSU_DEBUG is not set
# CONFIG_KPM is not set

# SUSFS v1.5.8 (ShirkNeko/susfs4ksu kernel-4.14 @ eda5e93)
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_AUTO_ADD_SUS_KSU_DEFAULT_MOUNT=y
CONFIG_KSU_SUSFS_AUTO_ADD_SUS_BIND_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_TRY_UMOUNT=y
CONFIG_KSU_SUSFS_AUTO_ADD_TRY_UMOUNT_FOR_BIND_MOUNT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_HAS_MAGIC_MOUNT=y

# sus_su is deprecated and explicitly unsupported on non-GKI kernels.
# CONFIG_KSU_SUSFS_SUS_SU is not set

# Fingerprint: identical to the stock PixelOS/NetErnels kernel. kramel.sh's
# upr() sets this to "-NetErnels-<variant>"; PixelOS builds use "PixelOS", so
# uname -r stays 4.14.206-NetErnels-PixelOS and carries no root-related string.
CONFIG_LOCALVERSION="-NetErnels-PixelOS"
# CONFIG_LOCALVERSION_AUTO is not set
